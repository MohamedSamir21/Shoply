<?xml version="1.0" encoding="utf-8"?>
<!-- The Shoply smile bag (same shapes as ShoplyMark), drawn in its 100-unit design space and
     scaled into the 66dp safe zone of a 108dp adaptive icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="23"
        android:translateY="18.66">
        <!-- handle -->
        <path
            android:pathData="M33,44 V36 a17,17 0 0,1 34,0 V44"
            android:strokeColor="#E88A56"
            android:strokeLineCap="round"
            android:strokeWidth="9.5" />
        <!-- body -->
        <path android:pathData="M20,40 H80 a6,6 0 0,1 5.96,6.6 l-4,42 A7,7 0 0,1 75,95 H25 a7,7 0 0,1 -6.96,-6.4 l-4,-42 A6,6 0 0,1 20,40 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="50"
                    android:endY="100"
                    android:startX="50"
                    android:startY="0"
                    android:type="linear">
                    <item android:color="#E88A56" android:offset="0" />
                    <item android:color="#DE7A48" android:offset="0.5" />
                    <item android:color="#C96A3B" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- eyes -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M36.3,60 a3.7,4.8 0 1,0 7.4,0 a3.7,4.8 0 1,0 -7.4,0 Z M56.3,60 a3.7,4.8 0 1,0 7.4,0 a3.7,4.8 0 1,0 -7.4,0 Z" />
        <!-- smile -->
        <path
            android:pathData="M31,69 C35,84 65,84 69,69"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="6" />
    </group>
</vector>
